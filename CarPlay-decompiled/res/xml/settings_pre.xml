<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:key="rootSetting"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/app_setting" android:key="app_setting">
        <SwitchPreferenceCompat android:title="@string/box_insert_autostart" android:key="autoEnterApp" android:defaultValue="false" />
        <SwitchPreferenceCompat android:title="@string/autoStart" android:key="autoStart" />
        <ListPreference android:entries="@array/boot_mode" android:title="@string/boot_auto_connect_mode" android:key="autoBootMode" android:summary="@string/setting_value" android:entryValues="@array/boot_mode_value" />
        <Preference android:title="@string/setting_usb_delay" android:key="bootDelay" />
        <SwitchPreferenceCompat android:title="@string/setting_background_connection" android:key="back_connection" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/setting_media" android:key="mediaSetting">
        <PreferenceScreen android:title="@string/setting_screen_video" android:key="videoScreenSetting">
            <ListPreference android:entries="@array/video_decode_mode" android:title="@string/decode_mode" android:key="decodeMode" android:summary="@string/setting_value" android:defaultValue="1" android:entryValues="@array/video_decode_mode_value" />
            <ListPreference android:title="@string/setting_video_decoder" android:key="videoDecoder" android:summary="@string/setting_value" />
            <SwitchPreferenceCompat android:checked="true" android:title="@string/setting_async_decoder" android:key="asyncDecoder" />
            <ListPreference android:title="@string/setting_resolution" android:key="resolution" android:summary="@string/setting_value" android:dependency="lock_resolution" />
            <ListPreference android:title="@string/setting_carplay_icon_size" android:key="icon_size" android:summary="%s" android:defaultValue="1.0" android:entries="@array/carplay_icon_size" android:entryValues="@array/carplay_icon_size_value" />
            <SwitchPreferenceCompat android:checked="false" android:title="@string/setting_lock_resolution" android:key="lock_resolution" android:disableDependentsState="true" />
            <SwitchPreferenceCompat android:checked="false" android:title="@string/setting_show_statusbar" android:key="showStatusBar" android:dependency="lock_resolution" />
            <SwitchPreferenceCompat android:checked="false" android:title="@string/set_show_navigation" android:key="showNavigationBar" android:dependency="lock_resolution" />
            <Preference android:title="@string/carplayFps" android:key="carplayFps" />
            <SwitchPreferenceCompat android:title="@string/set_blur_screen" android:key="prevBlurredScreen" />
            <SwitchPreferenceCompat android:title="@string/setting_fix_resolution" android:key="fix_resolution" />
            <SwitchPreferenceCompat android:title="@string/prevent_overlay" android:key="preventOverlay" android:defaultValue="true" />
            <SwitchPreferenceCompat android:title="视频置顶" android:key="surface_on_top" android:defaultValue="true" />
            <SwitchPreferenceCompat android:title="保存视频数据" android:key="save_h264" android:defaultValue="false" />
        </PreferenceScreen>
        <PreferenceScreen android:title="@string/setting_screen_audio" android:key="audioScreenSetting">
            <SwitchPreferenceCompat android:checked="true" android:title="@string/setting_audio_focus_enable" android:key="audioFocusEnable" android:defaultValue="true" />
            <SwitchPreferenceCompat android:checked="true" android:title="@string/setting_audio_focus" android:key="useAudioFocus" android:dependency="audioFocusEnable" android:defaultValue="true" />
            <SwitchPreferenceCompat android:checked="true" android:title="@string/setting_duckmedia" android:key="audioDuck" android:defaultValue="true" />
            <Preference android:title="@string/setting_media_reduction_factor" android:key="duckFactor" />
            <SwitchPreferenceCompat android:title="@string/compatible_phone" android:key="compatiblePhoneAudio" />
            <SwitchPreferenceCompat android:title="@string/useDongleMic" android:key="useDongleMic" />
            <SwitchPreferenceCompat android:title="@string/compatible_phone_record" android:key="micCompatible" />
            <ListPreference android:entries="@array/audio_output_mode" android:title="@string/setting_audio_output_mode" android:key="audioOutputMode" android:entryValues="@array/audio_output_mode_value" android:defaultValue="0" />
            <SwitchPreferenceCompat android:title="@string/setting_audio_oboe" android:key="audioPlayer1" />
            <ListPreference android:title="@string/setting_audio_output_devices" android:key="audioDevice" android:summary="@string/setting_value" android:dependency="audioPlayer1" />
            <ListPreference android:entries="@array/aec_mode" android:title="@string/micAec" android:key="aecMode" android:summary="@string/setting_value" android:defaultValue="1" android:entryValues="@array/aec_mode_value" />
            <SwitchPreferenceCompat android:checked="false" android:title="@string/setting_high_audio_api" android:key="highAudioApi" android:defaultValue="false" />
            <SwitchPreferenceCompat android:title="@string/setting_phone_use_media" android:key="phoneUseMedia" android:dependency="highAudioApi" />
            <SwitchPreferenceCompat android:title="@string/setting_navi_use_media" android:key="naviUseMedia" android:dependency="highAudioApi" />
            <ListPreference android:title="@string/audioStreamType" android:key="audioStreamType" android:summary="@string/setting_value" android:defaultValue="3" />
            <ListPreference android:title="@string/setting_phone_stream_type" android:key="phoneStreamType" android:summary="@string/setting_value" android:defaultValue="0" />
            <ListPreference android:title="@string/setting_alt_stream_type" android:key="altStreamType" android:summary="@string/setting_value" android:defaultValue="13" />
            <ListPreference android:title="@string/audioStreamType" android:key="audioStreamType_H" android:summary="@string/setting_value" />
            <ListPreference android:title="@string/setting_phone_stream_type" android:key="phoneStreamType_H" android:summary="@string/setting_value" />
            <ListPreference android:title="@string/setting_alt_stream_type" android:key="altStreamType_H" android:summary="@string/setting_value" />
            <SwitchPreferenceCompat android:title="@string/setting_use_volume" android:key="volume_enable" />
            <Preference android:title="@string/setting_volume_media" android:key="volume_media" android:summary="@string/setting_value" android:dependency="volume_enable" />
            <Preference android:title="@string/setting_volume_phone" android:key="volume_phone" android:summary="@string/setting_value" android:dependency="volume_enable" />
            <Preference android:title="@string/setting_volume_alt" android:key="volume_alt" android:summary="@string/setting_value" android:dependency="volume_enable" />
            <Preference android:title="@string/setting_audio_testfix" android:key="recorder_test" />
            <Preference android:title="测试后排喇叭" android:key="audioFlag1" android:defaultValue="false" />
            <SwitchPreferenceCompat android:title="保存录音音频" android:key="save_record" android:defaultValue="false" />
            <SwitchPreferenceCompat android:title="保存播放音频" android:key="save_play" android:defaultValue="false" />
        </PreferenceScreen>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/carPlaySetting" android:key="carplaySetting">
        <SwitchPreferenceCompat android:title="@string/drivePosition" android:key="driverPosition" />
        <SwitchPreferenceCompat android:title="@string/nightMode" android:key="nightMode" android:disableDependentsState="true" />
        <SwitchPreferenceCompat android:title="@string/auto_night_mode_by_headlight" android:key="nightModeByLight" android:defaultValue="true" android:dependency="nightMode" />
        <SwitchPreferenceCompat android:checked="true" android:title="@string/autoNightMode" android:key="autoNightMode" android:dependency="nightMode" android:defaultValue="true" />
        <Preference android:title="@string/swcKey" android:key="swcKey" />
        <EditTextPreference android:maxLength="10" android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ&amp;@#!$%^*()&lt;>'&quot;" android:title="@string/oemLabel" android:key="oemText" android:inputType="text" />
        <Preference android:title="@string/oemIcon" android:key="oemIcon" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/otherSetting" android:key="otherSetting">
        <PreferenceScreen android:key="advanceSetting" app:title="@string/setting_advance">
            <Preference android:title="@string/setting_advance_notice" android:key="otherSettingNotice" />
            <Preference android:title="@string/setting_skipUsb" android:key="skipUsbDialog" />
            <ListPreference android:entries="@array/android_mode" android:title="@string/androidPhone" android:key="androidPhone" android:summary="@string/setting_value" android:entryValues="@array/android_mode_value" />
            <SwitchPreferenceCompat android:checked="false" android:title="@string/setting_enhance_usb" android:key="enhanceUsb" android:defaultValue="false" />
            <SwitchPreferenceCompat android:checked="false" android:title="Save Logs" android:key="saveLog" android:defaultValue="false" />
            <Preference android:title="@string/uploadLogFiles" android:key="uploadLog" />
            <Preference android:title="@string/setting_reset_all" android:key="resetAllSettings" />
        </PreferenceScreen>
        <ListPreference android:entries="@array/language_mode" android:title="@string/language" android:key="language" android:summary="@string/setting_value" android:defaultValue="0" android:entryValues="@array/language_mode_value" />
        <SwitchPreferenceCompat android:checked="false" android:title="@string/setDarkTheme" android:key="lightTheme" android:defaultValue="false" />
        <Preference android:title="@string/cleanCache" android:key="cleanCache" />
        <Preference android:title="@string/update" android:key="update" />
        <Preference android:title="@string/setting_update_dongle" android:key="updateDongle" />
        <Preference android:title="@string/feedback" android:key="feedback" />
        <Preference android:title="@string/about" android:key="about" />
    </PreferenceCategory>
</PreferenceScreen>
